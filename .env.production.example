# Copy values into Vercel → Environment Variables (Production + Preview).
# Vite inlines these at build time — changing them requires a redeploy.
#
# Backend ALLOWED_ORIGINS must list this frontend origin (and preview URLs if used).

VITE_API_URL=https://api.YOUR-DOMAIN.com
# FastAPI as well — this is /chat-voice TTS on the AI Tutor page, not voice tutor.
VITE_VOICE_URL=https://api.YOUR-DOMAIN.com
# Nest Voice/backend. Its CORS_ORIGINS must list this frontend origin, and the
# host must pass through WebSocket upgrades on /rtc/voice.
VITE_RTC_URL=https://voice.YOUR-DOMAIN.com
VITE_VOICE_SERVER_STT=true
VITE_BARGE_CONFIRMED=true
# Desktop Chrome's built-in SpeechRecognition has its own non-configurable
# endpointing and can cut off short trailing words (e.g. "what is wit" →
# "what is") — server Whisper's silence timing is ours to tune. Without this,
# Whisper is only primary on mobile/no-browser-STT; this makes it primary
# everywhere listen-mode capture happens.
VITE_WHISPER_LISTEN_PRIMARY=true
# How long a student can pause mid-question before the server-Whisper listen
# capture decides they're done and submits. Default below already accounts for
# a natural "thinking pause"; raise further only if longer questions still get
# cut off in practice.
VITE_LISTEN_SILENCE_MS=1800

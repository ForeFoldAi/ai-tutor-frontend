# Two backends. They are different processes and must not share one URL:
#   VITE_API_URL / VITE_VOICE_URL → FastAPI :8000  (auth, chat, RAG, /chat-voice TTS)
#   VITE_RTC_URL                  → Nest  :8080  (voice tutor: /rtc/*, WS /rtc/voice)
# Local dev: leave the FastAPI ones empty so Vite proxies /auth → :8000.
# Vercel / static host: set absolute HTTPS URLs (no Vite proxy).

VITE_API_URL=http://127.0.0.1:8000
VITE_VOICE_URL=http://127.0.0.1:8000
VITE_RTC_URL=http://127.0.0.1:8080

# --- Production (Vercel → Environment Variables) ---
# VITE_API_URL=https://api.YOUR-DOMAIN.com          # FastAPI (auth, chat, RAG)
# VITE_VOICE_URL=https://api.YOUR-DOMAIN.com        # FastAPI too — /chat-voice on /ai-tutor
# VITE_RTC_URL=https://voice.YOUR-DOMAIN.com        # Nest Voice/backend (/rtc/*, WebRTC)
# Events WS: wss://api.YOUR-DOMAIN.com/ws/events
# Lesson planner WS: wss://api.YOUR-DOMAIN.com + path from API
# Backend ALLOWED_ORIGINS and Voice/backend CORS_ORIGINS must both include your
# Vercel URL(s), e.g. https://app.forefoldai.com,https://your-app.vercel.app

# Voice: let the student interrupt by talking over the tutor (default: on).
# Turn off if the tutor's own audio through the speakers keeps triggering it.
# VITE_VOICE_BARGE_IN=false

# Demo login helpers (baked into client — avoid real secrets)
VITE_TEST_STUDENT_USERNAME=student
VITE_TEST_STUDENT_PASSWORD=password
VITE_TEST_TUTOR_USERNAME=tutor
VITE_TEST_TUTOR_PASSWORD=password
VITE_TEST_SCHOOL_ADMIN_USERNAME=admin
VITE_TEST_SCHOOL_ADMIN_PASSWORD=password
VITE_TEST_MASTER_ADMIN_USERNAME=master
VITE_TEST_MASTER_ADMIN_PASSWORD=password
VITE_TEST_ORG_ADMIN_USERNAME=organization
VITE_TEST_ORG_ADMIN_PASSWORD=password

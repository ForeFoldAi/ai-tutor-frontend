# Local dev: leave empty so Vite proxies /auth, /api, /ws → backend (see vite.config.ts).
# Vercel / any static host: set absolute HTTPS backend URLs (Vite proxy does not exist there).

VITE_API_URL=
VITE_VOICE_URL=

# --- Production (set these in Vercel Project → Settings → Environment Variables) ---
# VITE_API_URL=https://api.YOUR-DOMAIN.com
# VITE_VOICE_URL=https://api.YOUR-DOMAIN.com
# Voice WS: wss://api.YOUR-DOMAIN.com/ws/voice
# Events WS: wss://api.YOUR-DOMAIN.com/ws/events
# Lesson planner WS: wss://api.YOUR-DOMAIN.com + path from API
# Backend ALLOWED_ORIGINS must include your Vercel URL(s), e.g.
#   https://app.forefoldai.com,https://your-app.vercel.app

# Voice: allow student to interrupt while tutor speaks (default: on). Set to false to disable.
# VITE_VOICE_BARGE_IN=false
# Server Whisper STT: barge/post-interrupt capture (browser STT is primary for listen).
# VITE_VOICE_SERVER_STT=true
# Opt-in Whisper for listen mode on devices with weak browser STT:
# VITE_WHISPER_LISTEN_PRIMARY=true

# Demo login helpers (baked into client — avoid real secrets)
VITE_TEST_STUDENT_USERNAME=student
VITE_TEST_STUDENT_PASSWORD=password
VITE_TEST_TUTOR_USERNAME=tutor
VITE_TEST_TUTOR_PASSWORD=password
VITE_TEST_SCHOOL_ADMIN_USERNAME=admin
VITE_TEST_SCHOOL_ADMIN_PASSWORD=password
VITE_TEST_MASTER_ADMIN_USERNAME=master
VITE_TEST_MASTER_ADMIN_PASSWORD=password
VITE_TEST_ORG_ADMIN_USERNAME=organization
VITE_TEST_ORG_ADMIN_PASSWORD=password
